# Treat everything as text by default; line endings are handled per platform
* text=auto

# Keep Windows scripts CRLF, otherwise double-click launching and cmd parsing break
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary and archive formats, never diff them as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip  binary
*.7z   binary
*.gz   binary
